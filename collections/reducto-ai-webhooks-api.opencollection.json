{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reducto Classify Webhooks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Webhook Portal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.reducto.ai/configure_webhook",
            "headers": [
              {
                "name": "user-id",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Webhook Portal"
        }
      ]
    }
  ],
  "bundled": true
}