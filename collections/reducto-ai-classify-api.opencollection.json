{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reducto Classify API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Classify",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Classify",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.reducto.ai/classify",
            "headers": [
              {
                "name": "user-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Classify"
        },
        {
          "info": {
            "name": "Cite",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.reducto.ai/cite",
            "headers": [
              {
                "name": "user-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Locate exact bounding boxes for text citations in a parsed document.\n\nRequires the document to have been parsed with return_ocr_data=true."
        }
      ]
    }
  ],
  "bundled": true
}