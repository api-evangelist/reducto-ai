              "token": "{{bearerToken}}"
            }
          },
          "docs": "Pipeline"
        },
        {
          "info": {
            "name": "Pipeline Async",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.reducto.ai/pipeline_async",
            "headers": [
              {
                "name": "user-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Pipeline Async"
        }
      ]
    }
  ],
  "bundled": true
